# 로컬 예시: 실제 값은 backend/.env 에 작성 (Git 커밋 금지)
DATABASE_URL=mysql+pymysql://app_user:<password>@127.0.0.1:3306/ledger_db?charset=utf8mb4
JWT_SECRET_KEY=<openssl rand -hex 32 로 생성>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
ENABLE_DOCS=true

# AI 챗봇 (선택). AWS 키는 넣지 않는다 — 로컬은 `aws login` 자격 증명, EC2는 IAM 역할을 SDK가 자동 사용
CHAT_ENABLED=false
BEDROCK_REGION=ap-northeast-2
BEDROCK_MODEL_ID=global.anthropic.claude-opus-5-5
BEDROCK_FALLBACK_MODEL_ID=global.anthropic.claude-opus-4-8
CHAT_RATE_LIMIT_PER_MIN=10
